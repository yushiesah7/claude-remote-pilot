## Discord Bot Token
# Discord Developer Portal で取得したBotトークン
DISCORD_TOKEN=

## Access Control (推奨)
# Botを操作できるDiscordユーザーID（カンマ区切りで複数指定可）
# 例: ALLOWED_USER_IDS=123456789012345678,234567890123456789
ALLOWED_USER_IDS=

## Optional paths
# 作業対象の親ディレクトリ（未指定なら実行時のカレントディレクトリ）
PROJECTS_ROOT=
# claude CLI のパス（未指定なら PATH から `claude` を探す）
CLAUDE_BIN=
# claude 実行時に使う HOME（未指定なら現在の HOME）
CLAUDE_HOME=
